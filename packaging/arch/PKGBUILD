# Maintainer: OpenStream100 contributors <openstream100@users.noreply.github.com>
pkgname=hercules-stream100
pkgver=0.17.1
pkgrel=1
pkgdesc="OpenStream100 PipeWire controller for Hercules Stream 100 hardware"
arch=('x86_64' 'aarch64')
url="https://github.com/AnaheimTulley/OpenStream100"
license=('MIT')
depends=(
    'bash'
    'avahi'
    'fontconfig'
    'gdk-pixbuf2'
    'glib2'
    'gtk4'
    'hicolor-icon-theme'
    'libpulse'
    'libusb'
    'pipewire'
    'pipewire-pulse'
    'python'
    'python-gobject'
    'python-pillow'
    'python-pyusb'
    'qrencode'
    'systemd'
    'wireplumber'
)
optdepends=(
    'playerctl: media control actions for programmable buttons'
)
makedepends=(
    'appstream'
    'desktop-file-utils'
    'gcc'
    'pkgconf'
)
source=(
    "${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
    'appstream-metadata.patch'
    'arch-install-path.patch'
)
sha256sums=(
    '8f4e2a90d1ef9e4023bab3baddefb16a86ac9374bc35affba156db79fe52ba29'
    '9f58463f8ee2bfd099e207136b9308f56c4497984223d0324a658497eb4e24cf'
    'ace0d0b3117652fea74ce7a8cf06920a9fc20fc05bd91097eb613a03264f636a'
)

_source_root="${pkgname}-${pkgver}"

prepare() {
    cd "${srcdir}/${_source_root}"
    patch -Np1 -i "${srcdir}/appstream-metadata.patch"
    patch -Np1 -i "${srcdir}/arch-install-path.patch"
}

build() {
    cd "${srcdir}/${_source_root}"

    gcc ${CPPFLAGS} ${CFLAGS} -std=c11 -Wall -Wextra \
        stream100-display-helper.c \
        -o stream100-display-helper \
        $(pkg-config --cflags --libs libusb-1.0) \
        ${LDFLAGS}
}

check() {
    cd "${srcdir}/${_source_root}"

    python -m py_compile \
        stream100-control.py \
        stream100-display-service.py \
        stream100-mixer.py \
        stream100-mixer-alpha.py \
        stream100_virtual_mixer.py \
        stream100_remote.py \
        stream100-test-notepad.py \
        stream100-test-remote.py \
        stream100-test-virtual-mixer.py \
        stream100_channel_icons.py \
        stream100_version.py
    python stream100-test-notepad.py
    python stream100-test-virtual-mixer.py
    python stream100-test-remote.py

    desktop-file-validate packaging/com.hercules.Stream100.desktop
    appstreamcli validate --no-net \
        packaging/com.hercules.Stream100.metainfo.xml

    gcc ${CPPFLAGS} ${CFLAGS} -std=c11 -Wall -Wextra \
        stream100-test-native-meters.c \
        -o stream100-test-native-meters \
        $(pkg-config --cflags --libs libusb-1.0) \
        ${LDFLAGS}
    ./stream100-test-native-meters
}

package() {
    cd "${srcdir}/${_source_root}"
    local libexec_dir="${pkgdir}/usr/lib/${pkgname}"

    install -d \
        "${libexec_dir}" \
        "${pkgdir}/usr/bin" \
        "${pkgdir}/usr/lib/systemd/user" \
        "${pkgdir}/usr/lib/udev/rules.d" \
        "${pkgdir}/usr/share/applications" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps" \
        "${pkgdir}/usr/share/metainfo" \
        "${pkgdir}/usr/share/man/man1" \
        "${pkgdir}/usr/share/doc/${pkgname}" \
        "${pkgdir}/usr/share/licenses/${pkgname}"

    install -m0755 \
        run-stream100-control.sh \
        run-stream100-mixer.sh \
        run-stream100-virtual-mixer.sh \
        stream100-control.py \
        stream100-display-helper \
        stream100-display-service.py \
        stream100-mixer.py \
        stream100-mixer-alpha.py \
        stream100_virtual_mixer.py \
        "${libexec_dir}/"

    install -m0644 \
        stream100_remote.py \
        stream100_channel_icons.py \
        stream100_version.py \
        button_labels_overlay_basic.png \
        button_labels_overlay_boxes.png \
        button_labels_overlay_glass.png \
        button_labels_overlay_template.png \
        stream100-display-replay.bin \
        openstream100-startup.png \
        "${libexec_dir}/"

    install -m0755 packaging/hercules-stream100 \
        "${pkgdir}/usr/bin/hercules-stream100"

    install -m0644 \
        packaging/hercules-stream100.service \
        packaging/hercules-stream100-display.service \
        hercules-stream100-mixer.service \
        "${pkgdir}/usr/lib/systemd/user/"
    install -m0644 70-hercules-stream100.rules \
        "${pkgdir}/usr/lib/udev/rules.d/70-hercules-stream100.rules"

    desktop-file-install \
        --dir="${pkgdir}/usr/share/applications" \
        packaging/com.hercules.Stream100.desktop
    install -m0644 com.hercules.Stream100.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/com.hercules.Stream100.svg"
    install -m0644 packaging/com.hercules.Stream100.metainfo.xml \
        "${pkgdir}/usr/share/metainfo/com.hercules.Stream100.metainfo.xml"
    install -m0644 packaging/hercules-stream100.1 \
        "${pkgdir}/usr/share/man/man1/hercules-stream100.1"
    install -m0644 README-STREAM100.md \
        "${pkgdir}/usr/share/doc/${pkgname}/README-STREAM100.md"
    install -m0644 REMOTE-PROTOCOL.md \
        "${pkgdir}/usr/share/doc/${pkgname}/REMOTE-PROTOCOL.md"
    install -m0644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
