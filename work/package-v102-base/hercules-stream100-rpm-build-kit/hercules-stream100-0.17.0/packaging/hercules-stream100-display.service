[Unit]
Description=OpenStream100 persistent USB display broker
Documentation=man:hercules-stream100(1)

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/libexec/hercules-stream100/stream100-display-service.py
KillMode=mixed
TimeoutStopSec=15s
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
